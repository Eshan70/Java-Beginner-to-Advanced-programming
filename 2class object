package oop;

class teacher {

    String name, gender;    //this is class name teacher
    int number;

}

class car {

    int tier;
    String color;
}

public class main {

    public static void main(String[] args) {

        teacher ob = new teacher();  //this is object of teacher class
        ob.name = "eshan munshi";
        ob.gender = "male";
        ob.number = 1862966705;

        car ob1 = new car();
        ob1.color = "black";
        ob1.tier = 2;

        System.out.println("the teacher name is :" + ob.name);
        System.out.println("the teacher gender is :" + ob.gender);
        System.out.println("the teacher phone number is :" + ob.number);

        System.out.println("the car tier is:\n the car color is :" + ob1.tier);
    }

}
